{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://app-fabrika.local/contracts/p1-domain-report.schema.json",
  "title": "App-Fabrika P1 Domain Report",
  "description": "P1 → P2 geçiş kapısı: Domain Architect analiz çıktısı (.factory/domain-report.json)",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "entities",
    "roles",
    "module_matrix",
    "injected_modules",
    "approvals",
    "edge_cases",
    "security_context",
    "sql_draft",
    "file_manifest",
    "acceptance_criteria",
    "api_endpoints",
    "result"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "const": 1 },
    "project": { "type": "string", "minLength": 1 },
    "compliance": { "type": "string", "enum": ["kvkk", "gdpr", "none"] },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "fields"],
        "additionalProperties": true,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "fields": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "module_matrix": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": ["module", "status", "evidence", "justification"],
        "additionalProperties": false,
        "properties": {
          "module": { "type": "string", "minLength": 3 },
          "status": {
            "enum": ["present", "missing", "injected", "proposed"]
          },
          "evidence": {
            "type": "string",
            "minLength": 10,
            "description": "Kaynak referansı: dosya/satır veya tablo kanıtı (ör. SQL/veritabani.sql:users.role_id)"
          },
          "justification": {
            "type": "string",
            "minLength": 20,
            "description": "Modülün neden present/missing/injected/proposed olduğuna dair gerekçe — şablon değer yasak"
          }
        }
      }
    },
    "injected_modules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "approvals": {
      "type": "array",
      "items": { "type": "string" }
    },
    "edge_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "security_context": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "sql_draft": {
      "type": "object",
      "required": ["tables"],
      "additionalProperties": true,
      "properties": {
        "tables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "seed_rows": { "type": "integer", "minimum": 0 }
      }
    },
    "file_manifest": {
      "type": "array",
      "minItems": 1,
      "description": "P2'nin üreteceği hedef dosyalar (A1 whitelist gerekçesi: P2 dosya listesini tahmin etmez, kontrattan okur)",
      "items": {
        "type": "object",
        "required": ["path", "purpose"],
        "additionalProperties": true,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 3 }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 10 },
      "description": "P2'nin neyi başaracağı (qa-gate.sh okumak yasak → tek kaynak bu alan)"
    },
    "api_endpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "method"],
        "additionalProperties": true,
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "method": { "type": "string", "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
          "auth": { "type": "string" }
        }
      },
      "description": "REST uçları; API yoksa boş dizi (yokluğu değil, kararı belirtir)"
    },
    "result": { "const": "requirements-frozen" }
  }
}
