{
  "schema_version": 1,
  "tool": "auto-hooks",
  "note": "IDE chat sihri değil — orchestrate/mode script orkestrasyonu.",
  "hooks": [
    {
      "id": "from-brief-plan",
      "when": "mode.sh from-brief",
      "runs": ["plan-from-brief.sh", "denetle.sh (soft)"],
      "blocking": false
    },
    {
      "id": "p1-reality",
      "when": "orchestrate P1 → P2",
      "runs": ["reality-check.sh P1"],
      "blocking": true
    },
    {
      "id": "p1-denetle",
      "when": "orchestrate P1 → P2",
      "runs": ["denetle.sh", "plan-sync.sh"],
      "blocking": true
    },
    {
      "id": "p3-qa-pass",
      "when": "orchestrate QA PASS",
      "runs": ["reality-check.sh P3", "doctor.sh (teşhis)", "denetle.sh"],
      "blocking": true
    },
    {
      "id": "p3-qa-fail",
      "when": "orchestrate QA FAIL",
      "runs": ["classify-fail.sh", "adaptive-recover.sh"],
      "blocking": false
    },
    {
      "id": "p5-pre-package",
      "when": "orchestrate P5",
      "runs": ["denetle.sh"],
      "blocking": true
    },
    {
      "id": "p5-reality",
      "when": "orchestrate P5 after package",
      "runs": ["reality-check.sh P5"],
      "blocking": true
    },
    {
      "id": "debt-scan",
      "when": "denetle (kod varsa)",
      "runs": ["debt-scan.sh"],
      "blocking": false
    }
  ]
}
