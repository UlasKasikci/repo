{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "CLAUDE.md",
    "docs/WEB-EDITION.md"
  ],
  "permission": {
    "skill": {
      "kvkk-compliance": "allow",
      "admin-crud": "allow",
      "auth-rbac": "allow",
      "experimental-*": "deny"
    }
  },
  "provider": {
    "nvidia": {
      "models": {
        "z-ai/glm-5.3": {
          "options": {
            "reasoning_effort": "high"
          },
          "limit": {
            "context": 1048576,
            "output": 65536
          }
        }
      }
    }
  }
}
