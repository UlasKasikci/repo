{
  "factory": "Webrail",
  "version": "1.4.2",
  "description": "Webrail ajanları için önerilen MCP (web-only; Gradle/Android yok)",
  "required": [
    {
      "id": "cursor-ide-browser",
      "name": "Cursor IDE Browser",
      "priority": "P1",
      "agents": ["web-domain-architect", "web-frontend-specialist"],
      "purpose": "Doküman / rakip / UI doğrulama",
      "install": "Cursor Settings → MCP → cursor-ide-browser",
      "builtin": true
    },
    {
      "id": "github",
      "name": "GitHub MCP",
      "priority": "P1",
      "agents": ["web-core-engineer"],
      "purpose": "Fabrika deposu PR/CI (customer-app push yasak)",
      "install": "npx -y @modelcontextprotocol/server-github",
      "env": ["GITHUB_PERSONAL_ACCESS_TOKEN"],
      "package": "@modelcontextprotocol/server-github"
    }
  ],
  "forbidden": ["android-emulator", "gradle-dedicated"],
  "note": "MCP çıktısı sohbette taşınmaz — snapshots veya docs/findings yaz"
}
